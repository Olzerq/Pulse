PULSE_ENV=development
PULSE_LOG_LEVEL=info
PULSE_HTTP_ADDR=:8080
PULSE_SHUTDOWN_TIMEOUT=10s

POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092

# These addresses are useful when running a Go service on the host.
PULSE_POSTGRES_URL=postgres://pulse:pulse@localhost:5432/pulse?sslmode=disable
PULSE_REDIS_ADDR=localhost:6379
PULSE_KAFKA_BROKERS=localhost:9092
PULSE_KAFKA_CHECK_RESULTS_TOPIC=check.result
PULSE_KAFKA_PUBLISH_TIMEOUT=10s
PULSE_KAFKA_CONSUMER_GROUP=pulse-consumer
PULSE_CONSUMER_PROCESS_TIMEOUT=10s

PULSE_PINGER_POLL_INTERVAL=1s
PULSE_PINGER_MAX_CONCURRENCY=20
PULSE_PINGER_USER_AGENT=Pulse/0.1
